NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:5174
PUBLIC_API_ORIGIN=http://localhost:5174
# Program surface (2026-10-07, T-ADMIN-SPLIT): "all" (default) serves students/teachers and
# administrators together. On a server run two processes from the same build on separate ports:
# "user" (Web/, no administrator routes or secrets) and "admin" (AdminWeb/, only /api/v1/admin
# plus legal reading and client-error reports; needs ADMIN_WEB_ENABLED=true and USER_APP_ORIGIN).
# API_SURFACE=all
# Student/teacher screen origin for links in mail. Required when API_SURFACE=admin.
# USER_APP_ORIGIN=https://uribanhub.com
# Development may use 0. Production must inject the exact reverse proxy hop count (1-10).
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info
# 모든 로그 줄에 붙는 배포 신원. 없으면 unknown으로 찍히고 서비스는 정상 동작하지만,
# 장애 때 어느 배포본을 되돌려야 하는지 로그만으로 짚을 수 없다. 운영 배포는 채운다.
# INSTANCE_ID를 비우면 hostname(컨테이너에서는 컨테이너/pod 이름)을 쓴다.
RELEASE_ID=
IMAGE_DIGEST=
INSTANCE_ID=
SERVE_WEB=false
# Capabilities stay off by default. Selected-audience publishing may be enabled in production
# only after the deployment runbook's migration, restore, and role-isolation gates pass.
# Attendance notifications and password reset remain blocked in production.
# Outside production, true is accepted only in test or an explicit local-test-admin fixture.
ATTENDANCE_NOTIFICATIONS_ENABLED=false
CONTENT_SELECTED_AUDIENCE_ENABLED=false
STUDENT_ASSESSMENTS_ENABLED=false
POLLS_ENABLED=false
PASSWORD_RESET_ENABLED=true
# Separate real administrator authentication. This foundation is non-production only until the
# deployment security gate is approved. When true, inject both values below from a secret store.
ADMIN_WEB_ENABLED=false
# ADMIN_MFA_ENCRYPTION_KEY=<canonical base64url encoding of exactly 32 random bytes>
# ADMIN_MFA_KEY_VERSION=<version label such as dev-1>
LOCAL_TEST_ADMIN_ENABLED=false
LOCAL_TEST_ADMIN_USERNAME=admin
LOCAL_TEST_ADMIN_OPERATOR_EMAIL=admin@classhub.local
# Store only an Argon2id hash here. Never commit the raw password.
LOCAL_TEST_ADMIN_PASSWORD_HASH=

# Current PC uses the existing native MariaDB. Restore private .env.local values;
# these placeholders never initialize a database or replace existing credentials.
DATABASE_ENGINE=mariadb
DATABASE_URL=mariadb://classhub_app:<injected-password>@localhost:3307/classhub_mariadb_phase1_dev
DATABASE_TLS_CA_FILE=<absolute-path-to-mariadb-ca.pem>
DATABASE_ACCOUNT_HOST=%
# TLS switches (2026-10-07). Default "required": the DB connection needs TLS + the CA file above, and
# production accepts only rediss://. Set "disabled" only when the DB/Redis are reachable solely on the
# same host or a private container network; then remove the *_TLS_CA_FILE value and make the DB accounts
# REQUIRE NONE. Identity, server version and exact grant checks stay on either way.
# DATABASE_TLS_MODE=required
# WORKER_DATABASE_TLS_MODE=required
# RETENTION_DATABASE_TLS_MODE=required
# OPERATOR_DATABASE_TLS_MODE=required
# REDIS_TLS_MODE=required
# Isolated MariaDB configuration: use a DNS name matching the server certificate, an explicit
# account host, and a mounted trusted CA. The URL accepts no query or fragment. Inject passwords.
# DATABASE_ENGINE=mariadb
# DATABASE_URL=mariadb://classhub_app:<injected-password>@db.example.invalid:3306/classhub
# DATABASE_TLS_CA_FILE=/run/secrets/mariadb-ca.pem
# DATABASE_ACCOUNT_HOST=%
# WORKER_DATABASE_URL=mariadb://classhub_worker:<injected-password>@db.example.invalid:3306/classhub
# WORKER_DATABASE_TLS_CA_FILE=/run/secrets/mariadb-ca.pem
# WORKER_DATABASE_ACCOUNT_HOST=%
# WORKER_DATABASE_POOL_MAX=10
# MariaDB worker requires the reviewed worker_security_audit_v1 grants; local-test-admin stays off.
# API connection pool ceiling. Class-scoped writes queue on the same class row, so a blocked
# transaction holds its connection; too small a pool lets one busy class starve unrelated
# schools. Size it against instance count and the database's max_connections.
DATABASE_POOL_MAX=10
LOCAL_TEST_ADMIN_DATABASE_URL=postgresql://classhub_local_admin:local_admin_db_password@127.0.0.1:5432/classhub_dev
# Local development keeps process-specific DSNs together for convenience.
# In production, inject only the one DSN owned by each process. PostgreSQL DSNs require an
# explicit remote host/password/database and one lowercase sslmode=verify-full query.
# Do not combine production DSNs with NODE_TLS_REJECT_UNAUTHORIZED=0 or any PGSSL* variable.
MIGRATOR_DATABASE_URL=postgresql://classhub_migrator:local_migrator_password@127.0.0.1:5432/classhub_dev
OPERATOR_DATABASE_URL=mariadb://classhub_operator:<injected-password>@localhost:3307/classhub_mariadb_phase1_dev
WORKER_DATABASE_URL=mariadb://classhub_worker:<injected-password>@localhost:3307/classhub_mariadb_phase1_dev
RETENTION_DATABASE_URL=mariadb://classhub_retention:<injected-password>@localhost:3307/classhub_mariadb_phase1_dev
# MariaDB retention 사용 시: DATABASE_ENGINE=mariadb, 검증된 0035 잠금 seed/strict46 권한 필요.
# RETENTION_DATABASE_URL=mariadb://classhub_retention:CHANGE_ME@mariadb.example.com:3306/classhub
# RETENTION_DATABASE_TLS_CA_FILE=/run/secrets/mariadb-ca.pem
# RETENTION_DATABASE_ACCOUNT_HOST=%
# RETENTION_DATABASE_POOL_MAX=1
REDIS_URL=redis://127.0.0.1:6380
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001

# Local Mailpit intentionally uses loopback plaintext SMTP without authentication.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Production must inject both values from a secret manager; leave both unset for Mailpit.
# SMTP_USERNAME=<injected SMTP username>
# SMTP_PASSWORD=<injected SMTP password>
SMTP_FROM=no-reply@classhub.local
TERMS_POLICY_VERSION=2026-07-11
PRIVACY_POLICY_VERSION=2026-07-11
AGE_POLICY_VERSION=2026-07-11

# Development placeholders only. Never reuse these values in a deployed environment.
EMAIL_HMAC_KEY=replace-with-at-least-32-random-bytes
EMAIL_HMAC_KEY_VERSION=dev-1
OPERATOR_BOOTSTRAP_SECRET=replace-before-first-operator-bootstrap
OPERATOR_RECOVERY_SECRET=replace-before-break-glass-recovery
# NEIS live menus and operator sync: leave blank to use imported menus only.
# Inject the issued key from a secret manager; never commit a real key.
NEIS_API_KEY=
