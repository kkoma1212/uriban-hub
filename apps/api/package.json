{
  "name": "@classhub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @classhub/db build && corepack pnpm --filter @classhub/neis build && tsc -p tsconfig.build.json",
    "dev": "corepack pnpm run \"/^dev:(compile|serve)$/\"",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --enable-source-maps --watch --watch-kill-signal=SIGTERM --watch-preserve-output dist/main.js",
    "build": "corepack pnpm --filter @classhub/neis build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.app.config.ts && vitest run --config vitest.redis.config.ts && vitest run --config vitest.auth.config.ts && vitest run --config vitest.migration.config.ts",
    "openapi:generate": "tsc -p tsconfig.build.json && node --enable-source-maps dist/openapi/generate.js"
  },
  "dependencies": {
    "@classhub/db": "workspace:*",
    "@classhub/neis": "workspace:*",
    "@fastify/static": "10.1.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.6",
    "@simplewebauthn/server": "14.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.5",
    "kysely": "0.29.3",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.0.13",
    "oauth4webapi": "3.8.8",
    "parse5": "8.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
