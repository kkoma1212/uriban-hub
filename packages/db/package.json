{
  "name": "@classhub/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "codegen": "kysely-codegen --exclude-pattern pgmigrations --out-file src/generated/database.ts",
    "codegen:verify": "kysely-codegen --exclude-pattern pgmigrations --out-file src/generated/database.ts --verify",
    "migrate:up": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js up --database-url-var MIGRATOR_DATABASE_URL --migrations-dir ../../db/migrations",
    "migrate:down": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js down --database-url-var MIGRATOR_DATABASE_URL --migrations-dir ../../db/migrations --count 1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "kysely": "0.29.3",
    "mysql2": "3.24.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "8.0.4"
  }
}
