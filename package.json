{
  "name": "classhub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.11.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @classhub/api --filter @classhub/web --filter @classhub/worker dev",
    "dev:local": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-local.mjs",
    "local:start": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-local.mjs start",
    "local:stop": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-local.mjs stop",
    "local:restart": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-local.mjs restart",
    "local:status": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-local.mjs status",
    "sandbox:start": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-sandbox.mjs start",
    "sandbox:stop": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-sandbox.mjs stop",
    "sandbox:status": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/dev-sandbox.mjs status",
    "local:audit-health": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/audit-health.mjs --check --target=native-pc",
    "local:verify": "node OPERATIONS/native-runtime/run-project-node.mjs OPERATIONS/native-runtime/verify-local.mjs",
    "test:native-services": "node --test OPERATIONS/native-runtime/application-readiness.test.mjs OPERATIONS/native-runtime/redis-readiness.test.mjs OPERATIONS/native-runtime/runtime-command.test.mjs && node OPERATIONS/native-runtime/smoke-services.mjs",
    "test:native-browser": "node --import tsx OPERATIONS/native-runtime/browser-smoke.mjs",
    "test:mariadb-isolated": "node OPERATIONS/mariadb-dev/run-isolated-mariadb-spec.mjs",
    "dev:api": "corepack pnpm --filter @classhub/api dev",
    "dev:web": "corepack pnpm --filter @classhub/web dev",
    "web:build": "node scripts/build-web-deployment.mjs --mode preview",
    "web:build:production": "node scripts/build-web-deployment.mjs --mode production",
    "web:changes": "node scripts/build-web-deployment.mjs changes",
    "web:deployed": "node scripts/build-web-deployment.mjs mark-deployed",
    "admin-remote:web": "node scripts/build-web-deployment.mjs --admin-remote",
    "server:release": "node scripts/build-server-release.mjs build",
    "server:deployed": "node scripts/build-server-release.mjs mark-deployed",
    "docs:read": "node scripts/project-records.mjs read",
    "docs:search": "node scripts/project-records.mjs search",
    "dev:worker": "corepack pnpm --filter @classhub/worker dev",
    "db:local:start": "node OPERATIONS/mariadb-dev/start-native-pc.mjs",
    "review:host": "node --import tsx browser-qa/host-normal-synthetic-runtime.mjs --duration-minutes 1440",
    "review:stable": "corepack pnpm review:host",
    "review:onboarding-role": "node browser-qa/run-isolated-onboarding-role-e2e.mjs",
    "qa:ui-remediation": "corepack pnpm --filter @classhub/web build && node browser-qa/wave4-ui-remediation-qa.mjs",
    "operator:local": "node --env-file=.env.operator.local --import tsx apps/operator-cli/src/main.ts",
    "retention:local": "node --env-file-if-exists=.env.retention.local --env-file-if-exists=.env.local --import tsx apps/retention-cli/src/main.ts",
    "retention:attendance:local": "node --env-file-if-exists=.env.retention.local --env-file-if-exists=.env.local --import tsx apps/retention-cli/src/main.ts --target=attendance-notifications",
    "retention:guardian-consent:local": "node --env-file-if-exists=.env.retention.local --env-file-if-exists=.env.local --import tsx apps/retention-cli/src/main.ts --target=guardian-consent-requests",
    "retention:reminder:local": "node --env-file-if-exists=.env.retention.local --env-file-if-exists=.env.local --import tsx apps/retention-cli/src/main.ts --target=temporary-password-reminders",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:generate": "corepack pnpm licenses list --prod --json | node scripts/third-party-notices.mjs generate",
    "licenses:check": "corepack pnpm licenses list --prod --json | node scripts/third-party-notices.mjs verify",
    "verify:openapi-contract": "node scripts/verify-openapi-contract.mjs",
    "verify:openapi-generated": "node scripts/verify-openapi-generated.mjs",
    "test:openapi-generated": "node --test scripts/verify-openapi-generated.test.mjs",
    "verify:production-db-role-contract": "node OPERATIONS/scripts/verify-production-database-role-contract.mjs",
    "verify:role-denial-tests": "node scripts/verify-role-denial-test-coverage.mjs",
    "verify:route-inventory": "node scripts/verify-route-inventory.mjs",
    "verify:test-migration-source": "node --import tsx scripts/verify-test-migration-source.mjs",
    "verify:release-evidence": "node --test OPERATIONS/scripts/release-evidence-validator.test.mjs",
    "licenses:test": "node --test scripts/third-party-notices.test.mjs",
    "test:browser-qa-support": "node --test browser-qa/lib/content-updates-browser-support.test.mjs browser-qa/lib/fixture-evidence-contract.test.mjs browser-qa/lib/normal-synthetic-runtime.test.mjs browser-qa/lib/onboarding-role-runtime.test.mjs browser-qa/lib/repository-qa-command-contract.test.mjs browser-qa/lib/wave1-accessibility.test.mjs browser-qa/lib/wave1-manual-zoom.test.mjs browser-qa/lib/wave1-security-contracts.test.mjs",
    "test:browser-qa": "node --import tsx scripts/run-browser-qa.mjs",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "test:run": "corepack pnpm -r --workspace-concurrency=1 --if-present test:run",
    "test:integration": "corepack pnpm --filter @classhub/db test:integration && corepack pnpm --filter @classhub/api test:integration && corepack pnpm --filter @classhub/worker test:integration && corepack pnpm --filter @classhub/operator-cli test:integration && corepack pnpm --filter @classhub/retention-cli test:integration",
    "db:migrate:up": "corepack pnpm --filter @classhub/db migrate:up",
    "db:migrate:down": "corepack pnpm --filter @classhub/db migrate:down",
    "db:codegen": "corepack pnpm --filter @classhub/db codegen",
    "db:codegen:verify": "corepack pnpm --filter @classhub/db codegen:verify",
    "openapi:generate": "corepack pnpm --filter @classhub/api openapi:generate && corepack pnpm --filter @classhub/api-client generate",
    "check": "corepack pnpm format:check && corepack pnpm licenses:test && corepack pnpm licenses:check && corepack pnpm verify:release-evidence && corepack pnpm build && corepack pnpm test:native-services && corepack pnpm test:mariadb-isolated && corepack pnpm test:browser-qa-support && corepack pnpm test:openapi-generated && corepack pnpm verify:production-db-role-contract && corepack pnpm verify:openapi-generated && corepack pnpm verify:openapi-contract && corepack pnpm verify:test-migration-source && corepack pnpm verify:role-denial-tests && corepack pnpm verify:route-inventory && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:run && corepack pnpm test:integration && corepack pnpm test:browser-qa",
    "ci:local": "corepack pnpm check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.6.0",
    "prettier": "3.9.4",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.11"
  }
}
